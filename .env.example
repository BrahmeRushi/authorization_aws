PORT=3000

# Your merchant UPI ID. Leave blank to type it on the checkout page.
MERCHANT_VPA=
MERCHANT_NAME=
# Optional 4-digit merchant category code from your bank.
MERCHANT_CODE=

# PhonePe Payment Gateway (Standard Checkout). All four are required
# before the app can open PhonePe's hosted checkout and confirm payment.
# Sandbox keys come from the PhonePe Business dashboard, Developer Settings.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_MERCHANT_ID=

# Public https origin PhonePe can redirect back to. Required for hosted checkout.
PUBLIC_BASE_URL=
